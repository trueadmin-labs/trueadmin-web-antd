{
  "name": "@trueadmin/web-antd",
  "version": "0.1.2",
  "description": "Ant Design components for TrueAdmin web applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trueadmin-labs/trueadmin-web-antd.git"
  },
  "type": "module",
  "scripts": {
    "prepublishOnly": "npm test",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./action": {
      "types": "./src/action/index.d.ts",
      "default": "./src/action/index.js"
    },
    "./filter": {
      "types": "./src/filter/index.d.ts",
      "default": "./src/filter/index.js"
    },
    "./remote-select": {
      "types": "./src/remote-select/index.d.ts",
      "default": "./src/remote-select/index.js"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@ant-design/icons": ">=5",
    "antd": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
